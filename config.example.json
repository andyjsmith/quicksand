{
  "$schema": "./config.schema.json",
  "listen": "127.0.0.1:8484",
  "database": "quicksand.db",
  "secureCookies": false,
  "pve": {
    "url": "https://pve.example.lan:8006",
    "tokenId": "quicksand@pve!quicksand",
    "tokenSecret": "00000000-0000-0000-0000-000000000000",
    "fingerprint": "",
    "insecureSkipVerify": false,
    "pool": "quicksand"
  },
  "vmids": {
    "from": 9000,
    "to": 9099
  },
  "templates": [
    {
      "id": "win10",
      "vmid": 100,
      "node": "pve",
      "name": "Windows 10",
      "description": "Windows 10 with SPICE guest tools.",
      "os": "windows",
      "fullClone": false,
      "cores": 0,
      "memoryMiB": 0,
      "maxCores": 8,
      "maxMemoryMiB": 16384,
      "agent": false,
      "quota": {
        "user": 1,
        "global": 4
      }
    },
    {
      "id": "debian",
      "vmid": 101,
      "node": "pve",
      "name": "Debian 13",
      "os": "linux",
      "agent": true,
      "filesDir": "/root",
      "serial": "serial0"
    },
    {
      "id": "firefox",
      "vmid": 102,
      "node": "pve",
      "name": "Firefox",
      "description": "Firefox in a lightweight Linux VM.",
      "os": "linux",
      "agent": true,
      "launch": {
        "command": ["firefox"],
        "openURL": ["firefox", "{url}"],
        "restart": true
      }
    }
  ],
  "networks": [
    {
      "id": "isolated",
      "bridge": null,
      "label": "Isolated (no network)",
      "default": true
    },
    {
      "id": "lab",
      "bridge": "vmbr1",
      "label": "Lab network"
    },
    {
      "id": "internet",
      "bridge": "vmbr2",
      "vlan": 105,
      "label": "Internet access"
    }
  ],
  "agent": {
    "privateKey": "ed25519-private:<output of quicksand agent keygen>",
    "port": 7070,
    "proxy": "",
    "network": {
      "bridge": "qsagent",
      "subnet": "10.99.0.0/24",
      "serverIP": "10.99.0.1",
      "macPrefix": "02:51:53",
      "nic": "net1",
      "model": "e1000"
    }
  },
  "expiry": {
    "timeLimit": "7d",
    "extendDuration": "24h",
    "maxExtends": 3
  },
  "suspend": {
    "idleTime": "2h"
  },
  "quota": {
    "user": 5,
    "global": 50
  },
  "links": {
    "bridge": "vmbr9",
    "vlans": {
      "from": 100,
      "to": 199
    },
    "subnet": "10.98.0.0/16"
  }
}
