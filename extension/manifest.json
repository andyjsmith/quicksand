{
  "manifest_version": 3,
  "name": "Open in Quicksand",
  "description": "Open links in a fresh, throwaway Quicksand VM from the right-click menu.",
  "version": "0.0.0",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
